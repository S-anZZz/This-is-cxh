# cxh 博客 · systemd 运行环境变量
#
# 安装位置：/etc/cxh-blog/cxh-blog.env（权限 640，属主 root:cxh，含口令，不要提交到仓库）
# 修改后：systemctl restart cxh-blog

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=mysql

# ---------- 数据库（本机 MySQL）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cxh_blog
DB_USERNAME=cxh
# 由 install.sh 生成随机口令后写入；也可手工改成强口令
DB_PASSWORD=CHANGE_ME

# ---------- 管理员 ----------
CXH_ADMIN_USERNAME=admin
# 支持明文（启动时自动加密）或 $2a$... BCrypt 摘要
CXH_ADMIN_PASSWORD=CHANGE_ME

# ---------- 上传目录（systemd 单元里已声明为可写路径）----------
CXH_MEDIA_LOCATION=/opt/cxh-blog/uploads

# ---------- 运行参数 ----------
SERVER_PORT=8080
JAVA_OPTS="-XX:MaxRAMPercentage=60 -Duser.timezone=Asia/Shanghai -Djava.awt.headless=true"

# 首次部署想写入示例文章（含相册）时设为 true；文章表非空时不会重复写入
CXH_SEED_ENABLED=false
