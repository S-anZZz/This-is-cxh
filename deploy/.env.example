# cxh 博客 · 生产环境变量模板
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   然后逐项改成你自己的值（deploy/.env 已在 .gitignore 中排除）
#
# 说明：生产编排里所有口令都是必填（:? 语法），缺一个就起不来，
#       这样设计是为了避免"忘了改默认密码就上线"。

# ---------- 站点 ----------
# 你的域名（用于 Nginx 配置与证书申请，替换 deploy/nginx/cxh-blog.conf 里的 server_name）
SITE_DOMAIN=cxh.example.com

# ---------- 管理员（后台登录）----------
CXH_ADMIN_USERNAME=admin
# 建议用强口令；也可以填 BCrypt 摘要（$2a$...），避免明文留在 .env
CXH_ADMIN_PASSWORD=change-me-to-a-strong-password

# ---------- 数据库 ----------
DB_NAME=cxh_blog
DB_USERNAME=cxh
DB_PASSWORD=change-me-too
MYSQL_ROOT_PASSWORD=change-me-as-well

# ---------- 可选 ----------
# 首次部署想写入示例文章（含相册），设为 true；文章表非空时不会重复写入
CXH_SEED_ENABLED=false
